# ============================================================================
# Cowherd Acharya app — environment variables
# ============================================================================
# Uses the shared OMNIDEL Supabase project with the gunakul schema for identity
# and acharya_cowherd schema for content.

# Supabase — the omnidel-platform project.
# Schemas: gunakul (identity + telemetry), acharya_cowherd (content).
NEXT_PUBLIC_SUPABASE_URL=https://tvkxxnvukwnobdxvzerm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which Acharya this deployment represents (maps to gunakul.mst_acharyas.slug).
NEXT_PUBLIC_ACHARYA_SLUG=cowherd
NEXT_PUBLIC_ACHARYA_SCHEMA=acharya_cowherd

# Google Gemini API — used for chat (gemini-2.5-flash) and quiz (gemini-2.0-flash).
GOOGLE_GENERATIVE_AI_API_KEY=your-google-gemini-key-here

# Google Gemini Live — real-time voice overlay.
GEMINI_API_KEY=your-google-gemini-key-here

# Google TTS — learner voice (Chirp3-HD).
GOOGLE_TTS_KEY=your-google-tts-key-here

# Session secret — HMAC key for signing the cowherd-learner-session cookie
# (phone OTP login). Any long random string; must be identical across all
# serverless instances and every deploy, otherwise existing sessions break.
SESSION_SECRET=change-me-to-a-long-random-string
